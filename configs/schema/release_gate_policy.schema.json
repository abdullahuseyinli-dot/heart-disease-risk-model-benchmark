{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abdullahuseyinli-dot/heart-disease-risk-model-benchmark/schemas/release_gate_policy.schema.json",
  "title": "HeartShift release gate policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "max_git_blob_bytes",
    "prohibited_path_patterns",
    "prohibited_suffixes",
    "required_gates",
    "required_roles",
    "text_scan_exempt_prefixes",
    "text_suffixes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "max_git_blob_bytes": {"type": "integer", "minimum": 1},
    "prohibited_path_patterns": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "prohibited_suffixes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "uniqueItems": true
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
      "uniqueItems": true
    },
    "required_roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_-]+$"},
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:|/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      }
    },
    "text_scan_exempt_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:|/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      },
      "uniqueItems": true
    },
    "text_suffixes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "uniqueItems": true
    }
  }
}
