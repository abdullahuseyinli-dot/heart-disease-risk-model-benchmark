{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abdullahuseyinli-dot/heart-disease-risk-model-benchmark/schemas/prediction_table.schema.json",
  "title": "HeartShift prediction table contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "contract_id", "table_format", "primary_key", "columns", "evidence_status", "target_use", "record_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "prediction_table_contract"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "table_format": {"enum": ["parquet", "csv"]},
    "primary_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "logical_type", "nullable", "role"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "logical_type": {"type": "string", "minLength": 1},
          "nullable": {"type": "boolean"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_status": {"enum": ["locked", "post_outcome", "development", "smoke", "archived"]},
    "target_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels_used_for_selection", "unlabelled_features_used_for_adaptation"],
      "properties": {
        "labels_used_for_selection": {"type": "boolean"},
        "unlabelled_features_used_for_adaptation": {"type": "boolean"}
      }
    },
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
