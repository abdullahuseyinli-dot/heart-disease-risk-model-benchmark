{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abdullahuseyinli-dot/heart-disease-risk-model-benchmark/schemas/metric_table.schema.json",
  "title": "HeartShift metric table contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "contract_id", "table_format", "primary_key", "columns", "uncertainty", "record_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "metric_table_contract"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "table_format": {"enum": ["csv", "parquet"]},
    "primary_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "logical_type", "nullable", "role"],
        "properties": {
          "name": {"type": "string"},
          "logical_type": {"type": "string"},
          "nullable": {"type": "boolean"},
          "role": {"type": "string"}
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "method", "scope"],
      "properties": {
        "unit": {"type": "string"},
        "method": {"type": "string"},
        "scope": {"type": "string"}
      }
    },
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
