{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abdullahuseyinli-dot/heart-disease-risk-model-benchmark/schemas/report_manifest.schema.json",
  "title": "HeartShift report evidence sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "report_id", "evidence_status", "claim_scope", "source_records", "headline_tables", "validation", "record_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "report_evidence_manifest"},
    "report_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "evidence_status": {"enum": ["locked", "post_outcome", "development", "smoke", "archived"]},
    "claim_scope": {"type": "string", "minLength": 1},
    "source_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "headline_tables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "validator", "evidence"],
      "properties": {
        "status": {"enum": ["pass", "fail", "conditional"]},
        "validator": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/binding"}
      }
    },
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
