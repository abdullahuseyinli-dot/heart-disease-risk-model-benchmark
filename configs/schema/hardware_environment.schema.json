{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abdullahuseyinli-dot/heart-disease-risk-model-benchmark/schemas/hardware_environment.schema.json",
  "title": "HeartShift privacy-safe hardware environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "environment_id", "observed_date", "operating_system", "python", "cpu", "memory", "gpu", "software_runtime", "bound_run_manifests", "privacy", "record_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "hardware_environment"},
    "environment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "observed_date": {"type": "string", "format": "date"},
    "operating_system": {"type": "string", "minLength": 1},
    "python": {"type": "string", "minLength": 1},
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "physical_cores", "logical_processors"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "physical_cores": {"type": "integer", "minimum": 1},
        "logical_processors": {"type": "integer", "minimum": 1}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_bytes"],
      "properties": {"physical_bytes": {"type": "integer", "minimum": 1}}
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "memory_mib", "compute_capability", "driver_version", "driver_cuda_compatibility"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "memory_mib": {"type": "integer", "minimum": 1},
        "compute_capability": {"type": "string", "minLength": 1},
        "driver_version": {"type": "string", "minLength": 1},
        "driver_cuda_compatibility": {"type": "string", "minLength": 1}
      }
    },
    "software_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["torch", "torch_cuda_runtime"],
      "properties": {
        "torch": {"type": "string", "minLength": 1},
        "torch_cuda_runtime": {"type": "string", "minLength": 1}
      }
    },
    "bound_run_manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname_included", "username_included", "serial_numbers_included"],
      "properties": {
        "hostname_included": {"const": false},
        "username_included": {"const": false},
        "serial_numbers_included": {"const": false}
      }
    },
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
