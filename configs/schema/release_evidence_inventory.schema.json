{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abdullahuseyinli-dot/heart-disease-risk-model-benchmark/schemas/release_evidence_inventory.schema.json",
  "title": "HeartShift release evidence inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "candidate_commit", "version", "tag", "created_at_utc", "release_gate", "tree", "required_roles", "status", "record_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "release_evidence_inventory"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "version": {"type": "string", "minLength": 1},
    "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[a-z0-9.-]+)?$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "pass"}
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_count", "tree_sha256", "lfs_object_count", "lfs_bytes", "entries"],
      "properties": {
        "entry_count": {"type": "integer", "minimum": 1},
        "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lfs_object_count": {"type": "integer", "minimum": 0},
        "lfs_bytes": {"type": "integer", "minimum": 0},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "git_object", "git_blob_bytes"],
            "properties": {
              "path": {"type": "string"},
              "mode": {"type": "string"},
              "git_object": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
              "git_blob_bytes": {"type": "integer", "minimum": 0},
              "lfs_oid_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "lfs_size_bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "required_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256", "size_bytes"],
        "properties": {
          "role": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "status": {"const": "ready"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
