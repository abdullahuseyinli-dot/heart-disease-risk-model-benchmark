# Preserve downloaded and extracted raw evidence byte-for-byte.
data/raw/** -text -diff

# Columnar evidence is binary and must never receive line-ending conversion.
*.parquet -text

# Recovered coursework outputs retain the exact bytes of the local originals.
results/legacy_coursework_2025/** -text -whitespace
docs/legacy/notebook_sources/** -text -whitespace
assets/research/** -text -whitespace

# Published result text is hashed after deterministic UTF-8/LF rendering.
docs/RESULTS.md text eol=lf
docs/research/heart_natural_metrics.csv text eol=lf
docs/research/result_presentation_manifest.json text eol=lf

# The exact-candidate scanner compares this policy byte-for-byte with its Git blob.
configs/release/release_gate_policy_v1.json -text

# Generated run evidence is hashed byte-for-byte. Do not normalize line endings
# or ask textual-diff whitespace checks to reinterpret Windows CSV/JSON records.
artifacts/runs/** -text -diff
artifacts/reports/** -text -diff
artifacts/locks/** -text -diff
artifacts/failures/** -text -diff
data/processed/** -text -diff

# Keep machine-readable evidence byte-stable while allowing browser review.
artifacts/**/*.csv -text diff
artifacts/**/*.json -text diff
artifacts/**/*.md -text diff
artifacts/**/*.txt -text diff
artifacts/**/*.yaml -text diff
artifacts/**/*.yml -text diff
data/processed/**/*.csv -text diff
data/processed/**/*.json -text diff
data/processed/**/*.md -text diff
data/raw/**/*.json -text diff
data/raw/**/*.md -text diff
data/raw/**/*.txt -text diff

# Outer prediction evidence can exceed GitHub's 100 MiB object limit. Store new
# versioned outer Parquet artifacts as Git LFS objects while retaining their paths.
artifacts/runs/*-outer-v*/*.parquet filter=lfs diff=lfs merge=lfs -text
artifacts/runs/*-outer-v*/**/*.parquet filter=lfs diff=lfs merge=lfs -text
artifacts/reports/**/*.parquet filter=lfs diff=lfs merge=lfs -text
artifacts/runs/shiftguard-*/**/*.parquet filter=lfs diff=lfs merge=lfs -text
artifacts/runs/heart-controls-*/**/*.parquet filter=lfs diff=lfs merge=lfs -text
artifacts/runs/observed-backbones-*/**/*.parquet filter=lfs diff=lfs merge=lfs -text
artifacts/runs/support-router-*/**/*.parquet filter=lfs diff=lfs merge=lfs -text
artifacts/runs/historical-psmask-*/**/*.parquet filter=lfs diff=lfs merge=lfs -text
