{
  "common_parameters": {
    "batch_size": 384,
    "brier_beta": 0.0,
    "d_model": 32,
    "dro_lambda": 0.5,
    "dro_tau": 0.2,
    "dropout": 0.1,
    "evaluation_interval": 2,
    "inference_batch_size": 1024,
    "max_epochs": 30,
    "minimum_environment_size": 500,
    "n_heads": 4,
    "n_layers": 1,
    "patience_evaluations": 4,
    "validation_mask_replicates": 2,
    "weight_decay": 0.001
  },
  "data": {
    "canonical_path": "data/processed/uci_readmission_canonical_v1.parquet",
    "profile_path": "data/processed/uci_readmission_profile_v1.json",
    "source_splits": [
      "train"
    ],
    "split_path": "data/splits/uci_readmission_patient_grouped_v1.parquet",
    "target": "target_tableshift_any_readmission",
    "validation_split": "validation"
  },
  "device": "cuda",
  "experiments": [
    {
      "backend": "classical",
      "grid": {
        "C": [
          0.1,
          1.0
        ]
      },
      "model": "logistic",
      "name": "logistic_pooled",
      "weighting": "pooled"
    },
    {
      "backend": "classical",
      "grid": {
        "C": [
          0.1,
          1.0
        ]
      },
      "model": "logistic",
      "name": "logistic_environment_class_balanced",
      "weighting": "environment_class_balanced"
    },
    {
      "backend": "classical",
      "grid": {
        "num_leaves": [
          15,
          31
        ]
      },
      "model": "lightgbm",
      "name": "lightgbm_environment_class_balanced",
      "parameters": {
        "colsample_bytree": 0.8,
        "learning_rate": 0.03,
        "min_child_samples": 50,
        "n_estimators": 500,
        "reg_lambda": 5.0,
        "subsample": 0.8
      },
      "weighting": "environment_class_balanced"
    },
    {
      "backend": "classical",
      "grid": {
        "depth": [
          5,
          7
        ]
      },
      "model": "catboost",
      "name": "catboost_environment_class_balanced",
      "parameters": {
        "iterations": 500,
        "l2_leaf_reg": 5.0,
        "learning_rate": 0.03
      },
      "weighting": "environment_class_balanced"
    },
    {
      "backend": "neural",
      "grid": {
        "learning_rate": [
          0.0005
        ]
      },
      "name": "pooled_erm",
      "variant": "pooled"
    },
    {
      "backend": "neural",
      "grid": {
        "learning_rate": [
          0.0005
        ]
      },
      "name": "prior_separated",
      "variant": "prior_separated"
    },
    {
      "backend": "neural",
      "grid": {
        "learning_rate": [
          0.0001,
          0.0005
        ]
      },
      "name": "mirrams_equation9",
      "parameters": {
        "mirrams_confidence": 0.95,
        "mirrams_lambda_1": 15.0,
        "mirrams_lambda_2": 15.0,
        "mirrams_mask_rate": 0.2
      },
      "variant": "mirrams"
    },
    {
      "backend": "neural",
      "grid": {
        "learning_rate": [
          0.0005
        ]
      },
      "name": "ps_maskdro",
      "variant": "ps_maskdro"
    },
    {
      "backend": "neural",
      "grid": {
        "learning_rate": [
          0.0005
        ]
      },
      "name": "ps_maskdro_ane",
      "variant": "ps_maskdro_ane"
    }
  ],
  "mask_policies": [
    {
      "kind": "natural",
      "name": "natural"
    },
    {
      "kind": "mcar",
      "name": "mcar_10",
      "rate": 0.1
    },
    {
      "kind": "mcar",
      "name": "mcar_30",
      "rate": 0.3
    },
    {
      "kind": "mcar",
      "name": "mcar_50",
      "rate": 0.5
    },
    {
      "columns": [
        "race",
        "gender",
        "age",
        "weight"
      ],
      "kind": "panel",
      "name": "drop_demographics"
    },
    {
      "columns": [
        "diag_1",
        "diag_2",
        "diag_3"
      ],
      "kind": "panel",
      "name": "drop_diagnoses"
    },
    {
      "columns": [
        "num_lab_procedures",
        "num_procedures",
        "max_glu_serum",
        "A1Cresult"
      ],
      "kind": "panel",
      "name": "drop_tests"
    },
    {
      "columns": [
        "metformin",
        "repaglinide",
        "nateglinide",
        "chlorpropamide",
        "glimepiride",
        "acetohexamide",
        "glipizide",
        "glyburide",
        "tolbutamide",
        "pioglitazone",
        "rosiglitazone",
        "acarbose",
        "miglitol",
        "troglitazone",
        "tolazamide",
        "examide",
        "citoglipton",
        "insulin",
        "glyburide-metformin",
        "glipizide-metformin",
        "glimepiride-pioglitazone",
        "metformin-rosiglitazone",
        "metformin-pioglitazone"
      ],
      "kind": "panel",
      "name": "drop_medications"
    }
  ],
  "mask_replicates": 2,
  "protocol_version": "readmission-independent-inner-v1",
  "seeds": [
    7201,
    7202,
    7203
  ]
}
